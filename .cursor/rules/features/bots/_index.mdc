```go
func userIsMentionedMarkdown(text string, username string) bool {
    // @username 멘션 확인
}

func (b *MMBots) GetBotMentioned(text string) *Bot {
    for _, bot := range b.bots {
        if userIsMentionedMarkdown(text, bot.mmBot.Username) {
            return bot
        }
    }
    return nil
}
